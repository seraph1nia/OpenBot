# Run python3 scripts/local/init.py to create private, persistent local secrets.
# This file contains no credentials. Never add model API keys for this deployment.
COMPOSE_PROJECT_NAME=openbot-local
APP_PORT=3010
POSTGRES_PASSWORD=
KEY_ENCRYPTION_KEY=
COMPUTER_TOKEN=
SUPERVISOR_TOKEN=
MANAGED_AGENT_TOKEN=
AGENT_TOOL_TOKEN=
WORKER_SHARED_SECRET=
BOT_MODEL=gpt-5.6-sol
# Written by the official Intelligence CLI. Browser/host URLs stay on loopback.
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
CPK_INTELLIGENCE_API_KEY=
# OpenBot reads this name; connect-intelligence.py maps it without printing the key.
INTELLIGENCE_API_KEY=
# Container-only URLs: populated from the official stack's actual Docker port mapping.
INTELLIGENCE_CONTAINER_API_URL=
INTELLIGENCE_CONTAINER_WS_URL=
# Optional operator credentials: only paired values from the local evaluation deployment.
INTELLIGENCE_SERVICE_TOKEN=
INTELLIGENCE_PROJECT_ID=
# Leave blank until the logical Learning container exists. Server auto-assigns openbot.
CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=
